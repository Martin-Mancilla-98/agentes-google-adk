# Copiar este archivo como `.env` DENTRO de la carpeta de cada agente
# (por ejemplo, math_assistant/.env). ADK lo carga automáticamente.
#
#   copy .env.example math_assistant\.env      (Windows, CMD)
#   cp .env.example math_assistant/.env        (Linux / macOS / Git Bash)
#
# La clave se obtiene gratis en https://aistudio.google.com/apikey

# 0 = API de Gemini (Google AI Studio, gratis). 1 = Vertex AI (requiere Google Cloud con facturación).
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=pega_tu_api_key_aca
